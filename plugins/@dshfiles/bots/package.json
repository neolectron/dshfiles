{
  "name": "@dshfiles/bots",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral durable bot connections, conversations and first-class DSH workspace.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js",
    "./adapter": { "types": "./src/adapter.ts", "default": "./dist/adapter.js" },
    "./api": { "types": "./src/api.ts", "default": "./dist/api.js" }
  },
  "scripts": { "build": "dshx build", "test": "vitest run", "typecheck": "tsc -p tsconfig.json --noEmit", "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin", "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs" },
  "dependencies": { "@dshfiles/credential-port": "workspace:*", "@dshfiles/dshx": "workspace:*", "@dshfiles/plugin-ui": "workspace:*", "@dshfiles/shared-runtime": "workspace:*", "zod": "catalog:" },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:", "@deepseek-ai/dsh": "0.2.1-rc.2", "@deepseek-ai/dsh-client-connection": "catalog:", "@deepseek-ai/dsh-client-ui-layout": "catalog:", "@deepseek-ai/dsh-client-ui-primitives": "catalog:", "@deepseek-ai/dsh-client-ui-renderer": "catalog:", "@deepseek-ai/dsh-client-ui-sidebar": "catalog:", "@deepseek-ai/dsh-client-ui-slots": "catalog:", "@deepseek-ai/dsh-storage-domain": "catalog:", "@types/node": "catalog:", "@types/react": "catalog:", "react": "catalog:", "typescript": "catalog:", "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4", "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0-0", "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-slots"], "external": ["@dshfiles/shared-runtime"], "immediately": false } },
  "dshx": { "features": "./dshx.features.json" }
}
