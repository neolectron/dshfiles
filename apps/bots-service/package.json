{
  "name": "@dshfiles/bots-service",
  "version": "0.1.0",
  "private": true,
  "description": "A provider-neutral Node HTTP service owning durable Bots workers and storage.",
  "license": "MIT",
  "bin": {
    "bots-service": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "Dockerfile"
  ],
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/main.js",
    "start": "node dist/main.js",
    "test": "node --test tests/node-process.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-storage": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-storage-json": "catalog:",
    "@dshfiles/bots": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  }
}
